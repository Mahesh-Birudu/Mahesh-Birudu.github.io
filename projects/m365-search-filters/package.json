{
  "name": "m365-search-filters",
  "version": "1.0.1",
  "private": true,
  "overrides": {
    "handlebars": "$handlebars"
  },
  "engines": {
    "node": ">=22.22.2 <23.0.0"
  },
  "scripts": {
    "build": "heft build --clean --production",
    "package": "heft package-solution --production",
    "clean": "heft clean",
    "start": "heft start --clean",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-timeout=15000 tests/filters.test.tsx",
    "preview:build": "tsx scripts/build-preview.ts",
    "preview": "node scripts/serve-preview.cjs"
  },
  "dependencies": {
    "@microsoft/sp-core-library": "1.23.0",
    "@pnp/modern-search-extensibility": "2.2.0",
    "tslib": "2.8.1",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "@microsoft/sp-component-base": "1.23.0",
    "@microsoft/sp-lodash-subset": "1.23.0",
    "@mahesh/m365-search-brand": "file:../m365-search-brand"
  },
  "devDependencies": {
    "@microsoft/sp-module-interfaces": "1.23.0",
    "@microsoft/spfx-web-build-rig": "1.23.0",
    "@microsoft/spfx-heft-plugins": "1.23.0",
    "@rushstack/heft": "1.3.3",
    "@types/node": "22.20.5",
    "typescript": "5.8.3",
    "tsx": "4.23.15",
    "esbuild": "0.28.2",
    "handlebars": "4.7.10",
    "jsdom": "26.1.0",
    "@types/react": "17.0.93",
    "@types/react-dom": "17.0.26",
    "@types/webpack-env": "1.18.8",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "9.37.0"
  },
  "packageManager": "npm@10.9.9"
}
